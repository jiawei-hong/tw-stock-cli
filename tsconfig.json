{
  "compilerOptions": {
    "module": "esnext",
    "target": "es2022",
    "allowJs": true,
    "strict": true,
    "outDir": "./build",
    "noImplicitAny": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "moduleResolution": "bundler",
    "esModuleInterop": true,
    "resolveJsonModule": true,
    "skipLibCheck": true,
    "baseUrl": ".",
    "paths": {
      "@/*": ["src/*"]
    },
    "types": ["node", "vitest/globals"]
  },
  "include": ["./src/**/*", "./tests/**/*", "./*.config.ts"],
  "exclude": ["./node_modules"]
}
