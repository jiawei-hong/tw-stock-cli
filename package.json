{
  "name": "tw-stock",
  "version": "2.3.0",
  "description": "This is a search tw stock price with command",
  "main": "build/index.js",
  "bin": {
    "tw-stock": "build/index.js"
  },
  "files": [
    "build"
  ],
  "scripts": {
    "dev": "vite build --watch",
    "build": "vite build",
    "lint": "eslint --ext .ts,.js,.cjs,.mjs src/ tests/ *.config.ts",
    "typecheck": "tsc --noEmit",
    "format": "prettier --write 'src/**/*.{ts,js,cjs,mjs}' 'tests/**/*.{ts,js,cjs,mjs}' '*.config.ts' 'tsconfig*.json' '.eslintrc.json' 'package.json' '.github/workflows/ci.yml'",
    "format:check": "prettier --check 'src/**/*.{ts,js,cjs,mjs}' 'tests/**/*.{ts,js,cjs,mjs}' '*.config.ts' 'tsconfig*.json' '.eslintrc.json' 'package.json' '.github/workflows/ci.yml'",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "test:e2e": "yarn build && vitest run --config vitest.e2e.config.ts",
    "test:live": "yarn build && vitest run --config vitest.live.config.ts",
    "prepublishOnly": "yarn build"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/jiawei-hong/tw-stock-cli.git"
  },
  "keywords": [
    "tw-stock",
    "stock"
  ],
  "author": "Jiawei-Hong",
  "license": "MIT",
  "bugs": {
    "url": "https://github.com/jiawei-hong/tw-stock-cli/issues"
  },
  "homepage": "https://github.com/jiawei-hong/tw-stock-cli#readme",
  "dependencies": {
    "asciichart": "^1.5.25",
    "commander": "^9.3.0",
    "date-fns": "^2.29.3",
    "omelette": "^0.4.17",
    "string-width": "^4.2.3",
    "table": "^6.8.1"
  },
  "devDependencies": {
    "@types/asciichart": "^1.5.6",
    "@types/node": "^24",
    "@types/omelette": "^0",
    "@typescript-eslint/parser": "^8.0.0",
    "@vitest/coverage-v8": "^4.0.18",
    "cli-select": "^1.1.2",
    "eslint": "^8.9.0",
    "eslint-config-prettier": "^8.3.0",
    "eslint-plugin-prettier": "^4.0.0",
    "eslint-plugin-simple-import-sort": "^8.0.0",
    "prettier": "^2.5.1",
    "typescript": "~5.9.3",
    "vite": "^7.3.1",
    "vitest": "^4.0.18"
  },
  "packageManager": "yarn@4.12.0+sha512.f45ab632439a67f8bc759bf32ead036a1f413287b9042726b7cc4818b7b49e14e9423ba49b18f9e06ea4941c1ad062385b1d8760a8d5091a1a31e5f6219afca8"
}
